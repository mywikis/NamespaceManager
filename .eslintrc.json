{
	"root": true,
	"ignorePatterns": [
		"tests/e2e/.auth/",
		"tests/e2e/report/",
		"tests/e2e/test-results/"
	],
	"extends": [
		"wikimedia/client/common",
		"wikimedia/language/es2022",
		"wikimedia/mediawiki"
	],
	"overrides": [
		{
			"files": [
				"**/*.vue"
			],
			"extends": [
				"wikimedia/client/common",
				"wikimedia/vue3/es6"
			],
			"rules": {
				"vue/component-name-in-template-casing": [
					"error",
					"kebab-case"
				]
			}
		},
		{
			"files": [
				"tests/qunit/**/*.js"
			],
			"extends": [
				"wikimedia/qunit"
			]
		},
		{
			"files": [
				"tests/e2e/**/*.js"
			],
			"extends": [
				"wikimedia/server",
				"wikimedia/language/es2022"
			],
			"globals": {
				"mw": "readonly"
			},
			"rules": {
				"jsdoc/no-undefined-types": [
					"warn",
					{
						"definedTypes": [
							"APIRequestContext",
							"Locator",
							"Page"
						]
					}
				]
			}
		}
	]
}
